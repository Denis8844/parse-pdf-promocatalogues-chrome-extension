{
  "manifest_version": 3,
  "name": "Скачать каталоги",
  "version": "1.10.3",
  "description": "Скачивает страницы каталога promocatalogues.fr в PDF: находит страницы в панели миниатюр, загружает изображения в полном размере (zoomLargeWebP), конвертирует в JPEG и собирает PDF.",
  "minimum_chrome_version": "103",

  "permissions": [
    "tabs",
    "scripting",
    "downloads",
    "storage",
    "offscreen"
  ],

  "host_permissions": [
    "https://www.promocatalogues.fr/*",
    "https://promocatalogues.fr/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Скачать каталоги",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
